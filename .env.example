# Copy to .env (scripts\setup.ps1 does this for you). .env is git-ignored; never commit secrets.

# --- Django ---
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Cookies: leave false for http://localhost; set true behind https in production.
COOKIE_SECURE=false

# --- Database: postgres (default, via docker compose) or sqlite (quick local dev only) ---
DB_ENGINE=postgres
POSTGRES_DB=vezapp_planner
POSTGRES_USER=vezapp
POSTGRES_PASSWORD=vezapp_dev_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Hosted databases (Supabase and similar): set to require
POSTGRES_SSLMODE=prefer

# --- Demo data (scripts\seed.ps1). Synthetic users only; works only when DJANGO_DEBUG=true ---
DEMO_PASSWORD=Demo@12345

# --- AI assistant (Phase 5). The app works fully without these. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Frontend (optional; put in frontend\.env.local if you change them) ---
# BACKEND_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_APP_NAME=Vezapp Planner
